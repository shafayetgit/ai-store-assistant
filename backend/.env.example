# ━━ Application & Server ━━
PROJECT_NAME="AIStoreAssistant"
ENVIRONMENT="development"                    # development | staging | production
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="insecure-dev-secret-key-change-in-production"

# ━━ Online Store Backend ━━
STORE_BASE_URL="https://hnbpark.com"
STORE_API_KEY=""
STORE_API_SECRET=""
STORE_TIMEOUT_SECONDS=5.0
STORE_CATALOG_SYNC_INTERVAL_HOURS=1

# ━━ Meta Facebook Messenger ━━
META_APP_SECRET=""
META_VERIFY_TOKEN="aistore_verify_token_dev"
META_PAGE_ACCESS_TOKEN=""
META_GRAPH_API_VERSION="v21.0"

# ━━ LLM & AI Gateway (llm-gateway) ━━
LLM_GATEWAY_BASE_URL="http://localhost:8002/api/v1"
LLM_GATEWAY_API_KEY="gw_live_dev"
PRIMARY_LLM_MODEL="llama3.1:8b"
PRIMARY_EMBEDDING_MODEL="nomic-embed-text"

# ━━ Direct Cloud Fallback (Tier 2) ━━
FALLBACK_ENABLED=false
FALLBACK_LLM_PROVIDER="openai"
OPENAI_API_KEY=""
FALLBACK_LLM_MODEL="gpt-4o-mini"
LLM_TIMEOUT_SECONDS=10.0
LLM_MAX_TOOL_TURNS=3

# ━━ Vector Store & RAG ━━
EMBEDDING_DIMENSION=768
RAG_SIMILARITY_THRESHOLD=0.70
RAG_TOP_K=4

# ━━ Database & Cache ━━
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/aistore_db"
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# ━━ Guardrails & SLAs ━━
OFF_HOURS_MESSAGE="Our human customer care team is currently offline. We have recorded your message and will respond as soon as we open (9 AM - 6 PM)."
HANDOFF_ALERT_WEBHOOK_URL=""